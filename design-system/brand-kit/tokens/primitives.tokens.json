  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": [
          "Bebas Neue",
          "Impact",
          "sans-serif"
        ]
      },
      "body": {
        "$type": "fontFamily",
        "$value": [
          "Oswald",
          "Arial Narrow",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "body": {
        "$type": "fontWeight",
        "$value": 300
      },
      "emphasis": {
        "$type": "fontWeight",
        "$value": 400
      },
      "strong": {
        "$type": "fontWeight",
        "$value": 500
      },
      "display": {
        "$type": "fontWeight",
        "$value": 400
      }
    },
    "size": {
      "display-1": {
        "$type": "dimension",
        "$value": "72px"
      },
      "display-2": {
        "$type": "dimension",
        "$value": "52px"
      },
      "h1": {
        "$type": "dimension",
        "$value": "36px"
      },
      "h2": {
        "$type": "dimension",
        "$value": "28px"
      },
      "h3": {
        "$type": "dimension",
        "$value": "22px"
      },
      "eyebrow": {
        "$type": "dimension",
