    "$description": "45°-Fasen statt Radien. Radius immer 0."
  },
  "border": {
    "hairline": {
      "$type": "dimension",
      "$value": "1px"
    },
    "strong": {
      "$type": "dimension",
      "$value": "2px"
    },
    "heavy": {
      "$type": "dimension",
      "$value": "3px"
    },
    "focus": {
      "$type": "dimension",
      "$value": "2px"
    },
    "focus-inner": {
      "$type": "dimension",
      "$value": "1px"
    }
  },
  "typography": {
    "display-1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.display-1}",
        "fontWeight": 400,
        "lineHeight": 0.92,
        "letterSpacing": "0.02em"
      },
      "$description": "IMMER GROSS"
    },
    "h1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.h1}",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "0.02em"
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.h2}",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "0.02em"
      }
    },
    "h3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.h3}",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "0.02em"
      }
    },
    "eyebrow": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "{font.size.eyebrow}",
        "fontWeight": 400,
        "lineHeight": 1.1,
        "letterSpacing": "0.14em"
      }
    },
    "lead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.lead}",
        "fontWeight": 300,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.body}",
        "fontWeight": 300,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      }
    },
    "small": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "{font.size.small}",
        "fontWeight": 300,
        "lineHeight": 1.35,
        "letterSpacing": "0"
      }
    }
  },
  "gradient": {
    "tiefe": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.petrol-mid}",
          "position": 0
        },
        {
          "color": "{color.petrol}",
          "position": 1
        }
      ],
      "$extensions": {
        "de.queerleague.angle": "135deg"
      },
      "$description": "Standard-Hero. Weiß groß; Fließtext zur Petrol-Seite."
    },
    "pride": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.petrol}",
          "position": 0
        },
        {
          "color": "{color.pink}",
          "position": 1
        }
      ],
      "$extensions": {
        "de.queerleague.angle": "135deg"
      },
      "$description": "In OKLCH interpolieren (Mitte Violett). Weiß nur groß."
    },
    "sunset": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.orange}",
          "position": 0
        },
        {
          "color": "{color.pink}",
          "position": 1
        }
      ],
      "$extensions": {
        "de.queerleague.angle": "135deg"
      },
      "$description": "Feiern, Turniere, Wall of Fame. Ink-Text."
    },
    "flutlicht": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.yellow}",
          "position": 0
        },
        {
          "color": "{color.orange}",
          "position": 1
        }
      ],
      "$extensions": {
        "de.queerleague.angle": "135deg"
      },
      "$description": "Live, Mitmachen. Ink-Text, nie Weiß."
    },
    "spektrum": {
      "$type": "gradient",
      "$value": [
        {
          "color": "{color.petrol}",
          "position": 0
        },
        {
          "color": "{color.pink}",
          "position": 0.36
        },
        {
          "color": "{color.orange}",
          "position": 0.68
        },
        {
          "color": "{color.yellow}",
          "position": 1
        }
      ],
      "$extensions": {
        "de.queerleague.angle": "90deg"
      },
      "$description": "Nur Linien ≤ 8 px."
    }
  },
  "shadow": {
    "block": {
      "$type": "shadow",
      "$value": {
        "color": "{color.petrol}",
        "offsetX": "6px",
        "offsetY": "6px",
        "blur": "0px",
        "spread": "0px"
      },
      "$description": "Fester Versatzschatten, nie weich."
    },
    "block-sm": {
      "$type": "shadow",
      "$value": {
        "color": "{color.petrol}",
        "offsetX": "3px",
        "offsetY": "3px",
        "blur": "0px",
        "spread": "0px"
      }
    }
  }
}
